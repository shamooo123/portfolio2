---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Arrow from "../components/Arrow.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort((a,b) => a.data.order-b.data.order);
const featured = projects.filter(p => p.data.featured).slice(0,4);
---
<BaseLayout title="Hishaam Abbasi | Robotics Engineer" description="First Class Robotics Engineering graduate. Explore my work in mechanical design, embedded systems, material testing and practical robotics.">
  <Nav /><main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Robotics engineer · London, UK</p><h1 id="hero-title">From an idea<br />to a working<br /><span>prototype.</span></h1><p class="hero-intro">I’m Hishaam, a First Class Robotics Engineering graduate. I design, build and test physical systems, bringing mechanical hardware, electronics and code together.</p><div class="hero-actions"><a class="button button-primary" href="#projects">See what I’ve built <Arrow /></a><a class="cv-link" href="/assets/Hishaam_Ali_Abbasi_CV.pdf" download>Download CV <svg class="arrow" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg><span class="cv-format">PDF · 2 pages</span></a></div></div>
      <figure class="hero-figure"><a href="/projects/active-camera-gimbal/" class="hero-photo" aria-label="Explore the active camera gimbal project"><img src="/images/project3-1280.webp" srcset="/images/project3-640.webp 640w, /images/project3-1280.webp 1280w" sizes="(max-width: 760px) 100vw, 48vw" alt="My two-axis camera gimbal, showing the printed frame, servos and embedded electronics" width="1280" height="760" fetchpriority="high" /><span class="photo-corner photo-corner-tl" aria-hidden="true"></span><span class="photo-corner photo-corner-br" aria-hidden="true"></span><span class="photo-label">On the workbench</span></a><figcaption><span><span class="mono">01 /</span> Two-axis camera gimbal</span><a href="/projects/active-camera-gimbal/">Explore the build <Arrow diagonal /></a></figcaption></figure>
    </section>
    <div class="evidence-bar"><div class="container evidence-grid"><div><strong>First Class</strong><span>BEng Robotics Engineering<br />Queen Mary University of London</span></div><div><strong>8 components</strong><span>Redesigned for the Formula Student<br />suspension system</span></div><div><strong>4 materials</strong><span>Compared through testing for<br />a medical training prototype</span></div></div></div>
    <section id="projects" class="section container"><div class="section-heading"><div><p class="eyebrow section-kicker">01 / Selected work</p><h2>Engineering, in practice.</h2></div><a class="text-link" href="/projects/">All {projects.length} case studies <Arrow /></a></div><div class="project-grid">{featured.map((project,index) => <ProjectCard project={project} index={index} featured={index === 0} />)}</div><div class="more-work"><span>Also on the workbench: camera stabilisation, filament automation and a home server.</span><a class="text-link" href="/projects/">Explore all projects <Arrow /></a></div></section>
    <section id="about" class="about-section"><div class="container about-grid"><div class="about-portrait"><img src="/images/profile-640.webp" alt="Hishaam Ali Abbasi" width="640" height="853" loading="lazy" decoding="async" /><div class="portrait-caption"><span>Hishaam Ali Abbasi</span><span class="mono">Engineer & maker</span></div></div><div class="about-copy"><p class="eyebrow section-kicker">02 / About me</p><h2>I learn by<br />making things.</h2><p>I enjoy the theory behind robotics, but the part I keep coming back to is getting a physical system to work: finding the fault, changing the design, and testing it again.</p><p>That has taken me from repairing robotic hardware at Alvis Robotics to designing an anatomical forearm for a medical training prototype. At home, I build and modify printers, electronics and the server that runs my family’s services.</p><p>Outside engineering, I’m an Explorer Scout Leader. I founded a new section and run sessions, expeditions and camps for a group of 18 or more young people.</p><div class="education"><span class="eyebrow">Education / 2023–2026</span><h3>BEng Robotics Engineering</h3><p>First Class Honours · Queen Mary University of London<br />IMechE accredited</p><div class="academic-highlight"><span>Advanced Robotics Systems</span><strong>90.8%</strong></div><div class="academic-highlight"><span>Numerical Methods & Data Science</span><strong>86%</strong></div><a class="text-link" href="/assets/HEAR_Hishaam_Ali_Abbasi.pdf" target="_blank" rel="noopener noreferrer">View academic transcript <Arrow diagonal /></a></div></div></div></section>
    <section id="experience" class="section container experience-section"><div class="section-heading"><div><p class="eyebrow section-kicker">03 / Experience</p><h2>Solving problems<br />on real hardware.</h2></div></div><div class="experience-row"><div class="experience-meta"><span class="mono">AUG 2025 · 2 WEEKS</span><h3>Alvis Robotics</h3><p>Birmingham, UK</p></div><div class="experience-detail"><h3>Engineering Design & Research Intern</h3><p>Hands-on fault diagnosis and repair on explosive ordnance disposal robots.</p><ul><li>Traced a sensor and camera activation fault to incompatible driver boards on a Northrop Grumman unmanned ground vehicle, then replaced the boards to restore operation.</li><li>Disassembled a seized crawler drive and cleared trapped mud from its active-pitch mechanism to return the unit to operation.</li><li>Supported R&D planning with the Managing Director on next-generation EOD robot development.</li></ul></div></div><div class="additional-experience"><span class="eyebrow">Additional experience</span><div><h3>HSBC</h3><p>Insight programme, quantitative stream · 2024</p></div><div><h3>AT Medics</h3><p>Clinical data administration and clinic front of house · 2020–2021</p></div></div></section>
  </main><Footer />
</BaseLayout>
