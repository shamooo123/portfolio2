---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Typewriter from "../components/Typewriter.astro";
import { getCollection } from "astro:content";
import { TYPEWRITER_WORDS, SOCIAL } from "../site-config";

const projects = (await getCollection("projects"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const featured = [...projects.filter(p => p.data.featured), ...projects.filter(p => !p.data.featured)].slice(0, 6);
---

<BaseLayout
  title="Hishaam Ali Abbasi | Robotics Engineer and Developer"
  description="Final year BEng Robotics Engineering student at Queen Mary University of London. Embedded firmware, mechanical design, control systems, SLAM, and DevOps infrastructure."
>
  <div class="fixed inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(56,189,248,0.03),transparent_50%)]"></div>
  </div>

  <Nav />

  <main class="relative z-10">
    <section class="pt-32 pb-20 px-6 max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12">
      <div class="md:w-2/3">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-xs font-bold tracking-wider text-blue-400 uppercase bg-blue-500/10 rounded-full border border-blue-500/20">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          Graduating 2026 · Predicted First Class
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-4 leading-tight">
          Bridging software and <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-500 to-cyan-400">
            the physical world.
          </span>
        </h1>

        <div class="text-lg md:text-xl mb-6">
          <Typewriter prefix="I'm a" words={TYPEWRITER_WORDS} forceAnimate={true} />
        </div>

        <p class="text-lg text-slate-400 max-w-xl leading-relaxed mb-8">
          Hi, I'm Hishaam. End-to-end engineering experience across embedded firmware, mechanical design, control systems, SLAM, and DevOps infrastructure — from a high-fidelity medical training device to an autonomous TurtleBot3 deployment.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="#projects" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-all shadow-lg shadow-blue-500/20">
            See what I've built
          </a>
          <a href="/assets/Hishaam_Abbasi_CV.pdf" class="px-6 py-3 glass-panel hover:bg-white/5 text-white font-medium rounded-lg transition-all">
            Download CV
          </a>
          <a href="https://github.com/shamooo123" target="_blank" rel="noopener noreferrer" class="px-6 py-3 glass-panel hover:bg-white/5 text-white font-medium rounded-lg transition-all">
            GitHub
          </a>
          <a href="https://linkedin.com/in/hishaam-ali-abbasi" target="_blank" rel="noopener noreferrer" class="px-6 py-3 glass-panel hover:bg-white/5 text-white font-medium rounded-lg transition-all">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="md:w-1/3 relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
        <div class="relative aspect-square rounded-2xl overflow-hidden glass-panel border border-white/10">
          <img src="/images/profile.jpg" alt="Hishaam Ali Abbasi" class="w-full h-full object-cover" />
        </div>
      </div>
    </section>

    <div class="w-full border-y border-white/5 bg-black/20 backdrop-blur-sm py-6 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 flex flex-wrap gap-x-12 gap-y-4 justify-center md:justify-start text-slate-500 font-mono text-sm font-semibold tracking-tight">
        <span class="flex items-center gap-2 hover:text-blue-400 transition-colors"><span class="text-blue-500">01.</span> Python and C++</span>
        <span class="flex items-center gap-2 hover:text-blue-400 transition-colors"><span class="text-blue-500">02.</span> ROS2 and SLAM</span>
        <span class="flex items-center gap-2 hover:text-blue-400 transition-colors"><span class="text-blue-500">03.</span> Onshape and CAD</span>
        <span class="flex items-center gap-2 hover:text-blue-400 transition-colors"><span class="text-blue-500">04.</span> Embedded and ESP32</span>
        <span class="flex items-center gap-2 hover:text-blue-400 transition-colors"><span class="text-blue-500">05.</span> Additive Manufacturing</span>
      </div>
    </div>

    <section id="about" class="py-20 px-6 max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">A hands on approach.</h2>
          <p class="text-slate-400 mb-4 leading-relaxed">
            My approach to engineering is practical. I enjoy the mathematical side of robotics — control theory, kinematics, sensor fusion — but I learn best by building, testing, and iterating on real hardware.
          </p>
          <p class="text-slate-400 leading-relaxed mb-4">
            I treat my home setup as a rapid prototyping lab. From a production Proxmox server running GPU-accelerated Docker services, to Klipper-tuned 3D printers and a load-cell brake pedal set — every project is a chance to go deeper.
          </p>
          <p class="text-slate-400 leading-relaxed border-l-2 border-blue-500 pl-4 italic">
            Outside the lab, I'm an Explorer Scout Leader — I founded a new section from scratch and run weekly sessions, expeditions, and residential camps for 18+ young people.
          </p>
        </div>

        <div class="glass-panel p-6 rounded-xl">
          <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider text-blue-400">Education</h3>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-white font-medium">
                <span>BEng Robotics Engineering</span>
                <span>Graduating 2026</span>
              </div>
              <div class="text-slate-500 text-sm">Queen Mary University of London</div>
              <div class="flex gap-2 mt-1 flex-wrap">
                <span class="px-2 py-0.5 bg-blue-500/10 border border-blue-500/20 rounded text-xs text-blue-400">IMechE Accredited</span>
                <span class="px-2 py-0.5 bg-blue-500/10 border border-blue-500/20 rounded text-xs text-blue-400">Predicted First Class</span>
              </div>
            </div>

            <div class="pt-4 border-t border-white/5">
              <div class="text-sm text-slate-400">Academic highlights:</div>
              <div class="flex flex-wrap gap-2 mt-2">
                <span class="px-2 py-1 bg-white/5 rounded text-xs text-slate-300">Numerical Methods & Data Science (86%)</span>
                <span class="px-2 py-1 bg-white/5 rounded text-xs text-slate-300">Instrumentation & Measurements (76.1%)</span>
                <span class="px-2 py-1 bg-white/5 rounded text-xs text-slate-300">Control Systems & Analysis (78.9%)</span>
                <span class="px-2 py-1 bg-white/5 rounded text-xs text-slate-300">Modelling & Control (75.2%)</span>
                <span class="px-2 py-1 bg-white/5 rounded text-xs text-slate-300">Introduction to AI (74.7%)</span>
              </div>

              <div class="mt-4 flex flex-wrap gap-3">
                <a href="/assets/HEAR_Hishaam_Ali_Abbasi.pdf" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-xs font-medium text-white transition-all">
                  Download HEAR
                </a>
                <a href="/assets/cv_1page.pdf" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-xs font-medium text-white transition-all">
                  CV (1 page)
                </a>
                <a href="/assets/Hishaam_Abbasi_CV.pdf" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-xs font-medium text-white transition-all">
                  CV (2 page)
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-10 px-6 max-w-6xl mx-auto">
      <div class="glass-panel rounded-2xl border border-white/10 p-6 md:p-8">
        <h3 class="text-2xl font-bold text-white mb-2">Elsewhere</h3>
        <p class="text-slate-400 mb-5">
          YouTube has project videos. Instagram is professional and shows builds, progress, and behind the scenes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white transition">
            YouTube
          </a>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white transition">
            Instagram ({SOCIAL.instagramName})
          </a>
        </div>
      </div>
    </section>

    <section id="projects" class="py-24 px-6 max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <h2 class="text-4xl font-bold text-white mb-2">Things I've built</h2>
          <p class="text-slate-400">Case studies with decisions, architecture, and outcomes.</p>
        </div>
        <a class="hidden md:inline-flex text-sm text-blue-400 hover:underline" href="/projects">View all case studies</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featured.map((p, i) => (
          <ProjectCard
            href={`/projects/${p.slug}`}
            title={p.data.title}
            subtitle={p.data.subtitle}
            image={p.data.heroImage}
            tags={p.data.tags}
            index={i}
          />
        ))}
      </div>

      <div class="mt-10 md:hidden">
        <a class="text-sm text-blue-400 hover:underline" href="/projects">View all case studies</a>
      </div>
    </section>

    <section id="experience" class="py-20 px-6 max-w-6xl mx-auto border-t border-white/5">
      <h2 class="text-3xl font-bold text-white mb-12">Work experience</h2>

      <div class="space-y-8">
        <div class="glass-panel p-8 rounded-2xl hover:bg-white/5 transition-colors">
          <div class="flex flex-col md:flex-row gap-6 md:gap-12">
            <div class="md:w-1/4">
              <div class="text-blue-400 font-mono text-sm mb-1 font-bold">Aug 2025</div>
              <div class="text-white text-lg font-bold">Alvis Robotics</div>
              <div class="text-slate-500 text-sm">Birmingham, UK</div>
              <div class="text-slate-600 text-xs mt-1">EOD Systems</div>
            </div>
            <div class="md:w-3/4">
              <h3 class="text-xl font-bold text-white mb-3">Engineering Design and Research Intern</h3>
              <ul class="space-y-2 text-slate-400 leading-relaxed text-sm">
                <li class="flex gap-2"><span class="text-blue-500 mt-1 shrink-0">→</span>Diagnosed and resolved a firmware fault on a proprietary sensor and camera activation module on a legacy Northrop Grumman EOD UGV — traced to incompatible driver boards in the lighting and camera subsystem, restoring full operational functionality.</li>
                <li class="flex gap-2"><span class="text-blue-500 mt-1 shrink-0">→</span>Identified and resolved a mechanical failure where mud ingress had seized the active pitch mechanism on a tracked EOD platform's crawler drive — performed full disassembly, diagnosis, and clearance to return the unit to operational condition.</li>
                <li class="flex gap-2"><span class="text-blue-500 mt-1 shrink-0">→</span>Supported R&D planning alongside the Managing Director on next-generation EOD robot development.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="glass-panel p-8 rounded-2xl hover:bg-white/5 transition-colors">
          <div class="flex flex-col md:flex-row gap-6 md:gap-12">
            <div class="md:w-1/4">
              <div class="text-blue-400 font-mono text-sm mb-1 font-bold">Jul 2024</div>
              <div class="text-white text-lg font-bold">HSBC</div>
              <div class="text-slate-500 text-sm">London, UK</div>
            </div>
            <div class="md:w-3/4">
              <h3 class="text-xl font-bold text-white mb-3">Spring Insight Programme — Quantitative Stream</h3>
              <p class="text-slate-400 leading-relaxed text-sm">
                Analysed financial datasets and explored quantitative modelling workflows within the investment banking division over a 3-week programme. Evaluated career paths at the intersection of engineering and finance.
              </p>
            </div>
          </div>
        </div>

        <div class="glass-panel p-8 rounded-2xl hover:bg-white/5 transition-colors">
          <div class="flex flex-col md:flex-row gap-6 md:gap-12">
            <div class="md:w-1/4">
              <div class="text-blue-400 font-mono text-sm mb-1 font-bold">2021</div>
              <div class="text-white text-lg font-bold">AT Medics</div>
              <div class="text-slate-500 text-sm">London, UK</div>
            </div>
            <div class="md:w-3/4">
              <h3 class="text-xl font-bold text-white mb-3">Clinical Data Administrator</h3>
              <p class="text-slate-400 leading-relaxed text-sm">
                Processed and managed large volumes of clinical data, improving system efficiency and eliminating operational backlogs in medical practice management systems.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
