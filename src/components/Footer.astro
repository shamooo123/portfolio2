---
import { SITE, SOCIAL } from "../site-config";
import Arrow from "./Arrow.astro";
---
<footer id="contact" class="site-footer"><div class="container">
  <div class="footer-top"><div><p class="eyebrow">Have a project or role in mind?</p><h2>Let’s talk engineering.</h2><p>Robotics, mechanical design, embedded systems and making things work.</p></div><a class="contact-link" href={`mailto:${SITE.email}`}>Email me <Arrow diagonal /></a></div>
  <div class="footer-bottom"><a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a><div class="footer-socials">{[['GitHub',SOCIAL.github],['LinkedIn',SOCIAL.linkedin],['YouTube',SOCIAL.youtube],['Instagram',SOCIAL.instagram]].map(([label,href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}<Arrow diagonal /></a>)}</div><span class="copyright">© {new Date().getFullYear()} Hishaam Ali Abbasi</span></div>
</div></footer>
