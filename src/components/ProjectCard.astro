---
import Arrow from "./Arrow.astro";
const { project, index = 0, featured = false } = Astro.props;
const p = project.data;
---
<a class:list={["project-card", featured && "project-card-featured"]} href={`/projects/${project.slug}/`}>
  <div class:list={["project-image", p.imageStyle]}><img src={p.heroImage} alt={p.heroAlt ?? p.title} loading="lazy" decoding="async" width="1200" height="900" /><span class="project-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><span class="project-open" aria-hidden="true"><Arrow diagonal /></span></div>
  <div class="project-copy"><p class="eyebrow">{p.category}</p><h3>{p.cardTitle ?? p.title}</h3><p>{p.subtitle}</p><span class="text-link">View case study <Arrow /></span></div>
</a>
